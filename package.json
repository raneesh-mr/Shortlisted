{
  "name": "shortlisted",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/gen-regions.mjs && node scripts/gen-prompts.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/gen-regions.mjs && node scripts/gen-prompts.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node scripts/gen-regions.mjs && node scripts/gen-prompts.mjs && next typegen && tsc --noEmit",
    "pretest": "node scripts/gen-regions.mjs && node scripts/gen-prompts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:rls": "node --env-file=.env.local scripts/verify-rls.mjs",
    "gen": "node scripts/gen-regions.mjs && node scripts/gen-prompts.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@opennextjs/cloudflare": "^1.20.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "docx": "^9.12.0",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
