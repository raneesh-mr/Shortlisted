# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings > API). Without these the app runs in guest-only mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic. Used only by server routes. Without a key, CV import uses the basic (no-AI) parser.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Public app settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Shortlisted
