# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project settings > API). Without these the app runs in guest-only mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic. Used only by server routes. Without a key, CV import uses the basic (no-AI) parser.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Razorpay (Dashboard > Settings > API Keys; use rzp_test_ keys until KYC is done).
# Server only. Without them the pay button says payments aren't switched on yet.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks, URL https://<domain>/api/pay/webhook,
# events payment.captured, order.paid, payment.failed.
RAZORPAY_WEBHOOK_SECRET=

# Public app settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Shortlisted

# Phase 5 seams (optional)
# Link to Real Plannet's Career Blueprint, shown in Me when set.
NEXT_PUBLIC_CAREER_BLUEPRINT_URL=
